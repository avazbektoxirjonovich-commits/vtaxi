# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
ENVIRONMENT=development          # development | testing | staging | production
LOG_LEVEL=INFO

# --- Telegram -------------------------------------------------------------
BOT_TOKEN=changeme
# Leave WEBHOOK_URL empty to run in long-polling mode (local dev).
WEBHOOK_URL=

# --- PostgreSQL (SQLAlchemy 2.0 async, asyncpg driver) --------------------
DATABASE_URL=postgresql+asyncpg://vtaxi:vtaxi@localhost:5432/vtaxi

# Connection pool tuning -- ignored when ENVIRONMENT=testing (NullPool is
# used instead; see infrastructure/database/config.py).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# --- Redis (FSM storage, cache, Queue Engine state, throttling) -----------
REDIS_URL=redis://localhost:6379/0

# --- Payment providers (reserved, unused until a payments step ships) -----
# See docs/01-SOFTWARE-ARCHITECTURE.md SS14.11 -- seam only, no integration yet.
CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
PAYNET_MERCHANT_ID=
